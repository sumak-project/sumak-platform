{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "docs-researcher": {
      "description": "Automatically invoke before primary edits for any docs/ reading or analysis, or extensive repository exploration; returns only a compact summary of authoritative contracts, limits, and acceptance criteria",
      "mode": "subagent",
      "model": "opencode/hy4-flash-free",
      "steps": 12,
      "system": "Read AGENTS.md first. Search docs/ using the documented authority order and return only a compact summary of authoritative contracts, limits, and acceptance criteria. Quote exact requirement or contract IDs and cite file paths and line numbers. Reconcile conflicts explicitly. Never edit, move, delete, extract over, or force-add docs/. Do not infer implementation or approval from a proposal.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "docs/**",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "aws_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "confluence_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "github_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_list_mcp_resources",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_read_mcp_resource",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "test-builder": {
      "description": "Automatically invoke before primary edits whenever Unit, ArchUnit, Integration, Contract, or Security tests are created or updated; follows /sumak-quality-gate for one bounded SUMAK service",
      "mode": "subagent",
      "model": "opencode/tidepool-alpha-free#low",
      "steps": 20,
      "system": "Read AGENTS.md and load sumak-hexagonal-service plus sumak-quality-gate. Work on one bounded service and test objective. Preserve domain and database ownership boundaries. Prefer JUnit 5, AssertJ, ArchUnit, Testcontainers, and contract fixtures selected by the repository. Never weaken assertions or claim PASS without command evidence. Do not edit docs/ or production behavior merely to make a test pass.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "/tmp/opencode/*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "services/**/src/test/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "services/**/build.gradle.kts",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gradle *",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "sumak-hexagonal-service",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "sumak-quality-gate",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "aws_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "confluence_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "github_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_list_mcp_resources",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_read_mcp_resource",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "ops-git": {
      "description": "Automatically invoke as the complete Jira/Git lifecycle manager for bootstrap-ticket and close-ticket: select and transition Jira work, prepare branches from origin/dev, validate changes, commit, push, open and merge PRs after CI, synchronize dev, and close Jira with the PR link",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "steps": 30,
      "system": "Read AGENTS.md and load sumak-jira-git-flow before acting. You are the complete Jira/Git lifecycle manager. For bootstrap-ticket, select or resume the correct Jira issue, assign and transition it, then prepare a clean correctly named branch from origin/dev without discarding unrelated work. For close-ticket, validate the bounded diff and applicable local checks, stage reviewed paths only, commit and push, open the PR to dev, ensure Jira is In Review, wait for required CI, squash-merge, delete the remote branch, synchronize clean local dev, comment with the PR link, and transition Jira to Done. Use English for every technical artifact. Never edit docs/, expose secrets, bypass required checks, claim PASS without evidence, target qa/prod, or reset a dirty workspace.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "README.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "runbooks/**",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "infra/**/*.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": ".github/**/*.md",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "./gradlew *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gradle *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "python3 -m json.tool *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "node --check *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "terraform fmt -check*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "terraform validate *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "yamllint *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "helm lint *",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "sumak-jira-git-flow",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "aws_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "confluence_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "github_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_list_mcp_resources",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "opencode_read_mcp_resource",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
